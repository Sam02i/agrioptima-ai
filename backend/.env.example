DATABASE_URL=postgresql+psycopg://agrioptima:agrioptima_local_only@localhost:5432/agrioptima
# Free registration may be needed through data.gov.in's API tab.
DATA_GOV_API_KEY=replace_after_registration
DATA_GOV_MANDI_RESOURCE_ID=copy_resource_id_from_official_api_tab
# Cache entries rather than calling public services every screen refresh.
WEATHER_CACHE_MINUTES=360
MANDI_CACHE_MINUTES=720

# Production security. Generate AUTH_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_REQUIRED=false
AUTH_SECRET=development-only-change-me
ACCESS_TOKEN_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for changing Vercel preview hostnames:
ALLOWED_ORIGIN_REGEX=

# Optional private S3 / Cloudflare R2 storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional Razorpay sandbox/live credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
